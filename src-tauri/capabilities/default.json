{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-home-read-recursive",
      "allow": [{ "path": "$HOME/*.*/*" }]
    }
    "store:default",
    "dialog:default",
  ]
}
