---
import { base } from 'astro:config/client';
import { Image } from 'astro:assets';
import logo from '@workspace/shared-assets/images/logo_500.png';
interface Props {
  class?: string;
}
let { class: classes } = Astro.props;
---

<div class=` ${classes} isolate w-full b-t-1 b-t-[var(--color-base-100)] `>
  <footer class="mx-auto max-w-screen-2xl px-4 md:px-8 max-w-screen-xl">
    <div
      class="mb-16
    grid
    grid-cols-2
    gap-12
    pt-10
    md:grid-cols-4
    lg:grid-cols-5
    lg:gap-8
    lg:pt-12"
    >
      <div class="col-span-full lg:col-span-2">
        <!-- logo - start -->
        <div class="mb-4 lg:-mt-2">
          <a
            href={base}
            class="inline-flex items-center gap-2 text-xl font-bold text-gray-100 md:text-2xl"
            aria-label="logo"
          >
            <Image
              src={logo}
              width={50}
              height={50}
              class="size-8"
              alt="Logo"
            />
            <p class="font-recoleta font-medium">Cherit</p>
          </a>
        </div>
        <!-- logo - end -->

        <p class="mb-6 text-gray-400 sm:pr-8">
          Manage your personal brain as collection of Markdown notes. Open
          source, cross-platform, and free.
        </p>
      </div>

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Products
        </div>

        <nav class="flex flex-col gap-4">
          <a
            href=`${base}/download`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Download</a
          >
        </nav>
      </div>
      <!-- nav - end -->

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Resources
        </div>

        <nav class="flex flex-col gap-4">
          <a
            href=`${base}/docs/guides/how_to_setup_syncing`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Guides</a
          >

          <a
            href=`${base}/docs`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Docs</a
          >
          <a
            href=`${base}/inspiration`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Inspiration</a
          >
        </nav>
      </div>
      <!-- nav - end -->

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Legal
        </div>

        <nav class="flex flex-col gap-4">
          <a
            href=`${base}/terms`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Terms
          </a>

          <a
            href=`${base}/privacy`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Privacy</a
          >

          <a
            href=`${base}/contact`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >Contact</a
          >

          <a
            href=`${base}/license`
            class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
            >License</a
          >
        </nav>
      </div>
      <!-- nav - end -->
    </div>
    <div
      class="flex flex-col items-center justify-between gap-4 md:flex-row b-t-1 py-8 b-t-[var(--color-base-100)] font-bold"
    >
      <div class="text-center md:text-left">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          © 2022 - {new Date().getFullYear()}
          <a
            href="https://github.com/Keshav-writes-code"
            target="_blank"
            class="link link-primary"
          >
            keshav-writes-code
          </a>
        </p>
        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">
          Licensed under the
          <a href=`${base}/license` class="link hover:link-primary"> GPLv2 </a>
        </p>
      </div>
    </div>
  </footer>
</div>
