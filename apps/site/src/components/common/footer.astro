---
import { base } from "astro:config/client";
import { Image } from "astro:assets";
import logo from "@/assets/logo_500.png";
interface Props {
  class?: string;
}
let { class: classes } = Astro.props;
---

<div class=` ${classes} `>
  <footer class="mx-auto max-w-screen-2xl px-4 md:px-8">
    <div
      class="mb-16 grid grid-cols-2 gap-12 pt-10 md:grid-cols-4 lg:grid-cols-5 lg:gap-8 lg:pt-12"
    >
      <div class="col-span-full lg:col-span-2">
        <!-- logo - start -->
        <div class="mb-4 lg:-mt-2">
          <a
            href={base}
            class="inline-flex items-center gap-2 text-xl font-bold text-gray-100 md:text-2xl"
            aria-label="logo"
          >
            <Image
              src={logo}
              width={50}
              height={50}
              class="size-8"
              alt="Logo"
            />
            <p class="font-recoleta font-medium">Cherit</p>
          </a>
        </div>
        <!-- logo - end -->

        <p class="mb-6 text-gray-400 sm:pr-8">
          Manage your personal brain as collection of Markdown notes. Open
          source, cross-platform, and free.
        </p>
      </div>

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Products
        </div>

        <nav class="flex flex-col gap-4">
          <div>
            <a
              href=`${base}/download`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Download</a
            >
          </div>
        </nav>
      </div>
      <!-- nav - end -->

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Resources
        </div>

        <nav class="flex flex-col gap-4">
          <div>
            <a
              href=`${base}/guides`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Guides</a
            >
          </div>

          <div>
            <a
              href=`${base}/docs`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Docs</a
            >
          </div>
        </nav>
      </div>
      <!-- nav - end -->

      <!-- nav - start -->
      <div>
        <div class="mb-4 font-bold uppercase tracking-widest text-gray-100">
          Legal
        </div>

        <nav class="flex flex-col gap-4">
          <div>
            <a
              href=`${base}/terms`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Terms
            </a>
          </div>

          <div>
            <a
              href=`${base}/privacy`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Privacy</a
            >
          </div>

          <div>
            <a
              href=`${base}/contact`
              class="text-gray-400 transition duration-100 hover:text-indigo-500 active:text-indigo-600"
              >Contact</a
            >
          </div>
        </nav>
      </div>
      <!-- nav - end -->
    </div>

    <div
      class="border-t border-gray-800 py-8 text-center text-sm text-gray-400"
    >
      © 2021 - Present Flowrift. All rights reserved.
    </div>
  </footer>
</div>
