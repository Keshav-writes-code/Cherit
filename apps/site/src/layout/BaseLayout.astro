---
import "daisyui/theme/business.css";
import "daisyui/theme/dim.css";
import "daisyui/theme/dark.css";
import "daisyui/theme/black.css";
import "../styles/fonts.css";
import "../../../app/src/styles/global.css";

import { ClientRouter } from "astro:transitions";
import SeoHead from "@/components/common/seo_head.astro";
import { type PageMetadata } from "@/types";

interface Props {
  class?: string;
  theme?: string;
  page_metadata: PageMetadata;
}

const { class: classes, theme = "dark", page_metadata }: Props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead page_metadata={page_metadata} />
    <ClientRouter />
  </head>
  <body class={`${classes}`}>
    <slot />
  </body>
</html>
