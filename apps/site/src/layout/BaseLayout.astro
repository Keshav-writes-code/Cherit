---
import "daisyui/theme/business.css";
import "daisyui/theme/dim.css";
import "daisyui/theme/dark.css";
import "daisyui/theme/black.css";
import "../styles/fonts.css";
type Props = {
  class?: string;
  theme?: string;
};
const { class: classes, theme = "dark" }: Props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
  </head>
  <body class={`${classes}`}>
    <slot />
  </body>
</html>
