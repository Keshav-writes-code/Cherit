---
import SiteLayout from "@/layout/SiteLayout.astro";
import PagetopBG from "@/components/common/pagetop_background.html";
import DownloadBtnHeadless from "@/components/common/download_button_headless.svelte";
import type { PageMetadata } from "@/types";

let metadata: PageMetadata = {
  title: "Home",
  description:
    "Cherit is the 2MB note-taking powerhouse. Native performance on every platform. Markdown native, offline-first, and completely private. Just you and your thoughts.",
  open_graph: {
    title: "Cherit - Think Fast. Write Faster.",
    description:
      "Stop downloading entire web browsers just to write a grocery list. Cherit is a lightweight, local-first markdown editor.",
  },
  twitter: {
    title: "Cherit - The Lightweight Note-Taking App",
    description:
      "Native performance, 2MB size, Markdown support. Available on all platforms.",
  },
};
type Platform = {
  label: string;
  icon: string;
  binaries: { label: string; link: string }[]
}
const owner = "keshav-writes-code";
const repo = "cherit";
let baseUrl = `https://github.com/${owner}/${repo}/releases/latest/download`;
const file = (suffix: string) => `${baseUrl}/${repo}-${suffix}`;

let platforms: Platform[] = [
  { 
    label: "windows",
    icon: "i-tabler:brand-windows-filled", 
    binaries:[
      {label:"EXE (Installer)", link:file("windows-x64.exe")},
      {label:"MSI (Installer)", link:file("windows-x64.msi")}
    ] 
  },
  { 
    label: "macos",
    icon: "i-tabler:brand-apple-filled",
    binaries:[
      {label:"DMG (x64)", link:file("darwin-x64.dmg")},
      {label:"DMG (Apple Silicon)", link:file("darwin-aarch64.dmg")}
    ] 
  },
  { 
    label: "linux", icon: "i-mdi:linux",
    binaries:[
      {label:"Deb", link:file("linux-amd64.deb")},
      {label:"Rpm", link:file("linux-x86_64.rpm")},
      {label:"AppImage", link:file("linux-amd64.AppImage")}
    ] 
  },
  { 
    label: "android", 
    icon: "i-mdi:android",
    binaries:[
      {label:"APK (aarch64)", link:file("android-arm64.apk")},
      {label:"APK (armv7)", link:file("android-universal.apk")}
    ] 
  },
  { label: "IOS", icon: "i-mdi:apple-ios", binaries:[] },
];
---

<SiteLayout page_metadata={metadata} class="grid place-items-center">
  <PagetopBG />
  <h1 class="text-4xl sm:text-5xl font-bold text-center mt-50">Downloads</h1>

  <section class="section-container mt-20">
    <DownloadBtnHeadless
      client:load
      class="btn btn-primary btn-sm md:btn-md lg:btn-lg xl:btn-xl group flex justify-center hover:scale-103 [transition-property:_scale,_background] duration-300"
    />
    <div class="divider my-10">OR</div>
    <div class="tabs tabs-box gap-x-3 gap-y-12 w-full justify-center  bg-transparent">
      { platforms.map(({label, icon, binaries}, i)=>(
      <label class="tab flex gap-2 py-3 px-5 h-max items-center capitalize  ">
        <input type="radio" name="os_selector" checked={i==0} />
        <div class=`${icon} size-5`></div>
        <span class="text-xl" >{label}</span>
      </label>
      <div class=" tab-content bento-card max-w-3xl p-6">

        <p class="flex gap-2 font-semibold items-center text-xl w-max color-primary">
          <span class="i-tabler:download size-4 text-[var(--color-primary)]" ></span>
          Binaries
        </p>

        <div class="grid grid-cols-2 gap-2 mt-4" >

          {!binaries || !binaries.length && (
          <p>No Build for IOS Avaliable for now</p>
          )}
          { binaries.map(({label: text, link})=>(
          <a href={link} class="btn btn-lg" > 
            {text} 
            <div class="i-tabler:download size-4 color-gray" ></div>
          </a>
          )) }
        </div>
      </div>
      )) }
    </div>
  </section>
</SiteLayout>
