---
import BaseLayout from "@/layout/BaseLayout.astro";
---

<BaseLayout theme="dark" class="">
  <!-- Navbar -->
  <div
    class="navbar fixed top-0 z-50 bg-black/80 backdrop-blur-lg b-b-1 b-white/20 px-6 lg:px-12"
  >
    <div class="flex-1">
      <a class="btn btn-ghost text-2xl tracking-tighter font-bold">
        <iconify-icon icon="tabler:feather" class="text-primary text-3xl"
        ></iconify-icon>
        Cherit
      </a>
    </div>
    <div class="flex-none gap-4 hidden md:flex">
      <ul class="menu menu-horizontal px-1 font-medium">
        <li><a href="#features">Features</a></li>
        <li><a href="#speed">Speed</a></li>
        <li><a href="#download" class="text-primary">Download</a></li>
      </ul>
    </div>
  </div>

  <!-- Screen 1: Hero Section -->
  <section
    class="min-h-screen w-full relative flex items-center justify-center pt-20 overflow-hidden"
  >
    <canvas id="hero-canvas"></canvas>

    <div
      class="container mx-auto px-4 z-10 text-center w-full flex flex-col items-center"
    >
      <div
        class="animate-on-scroll w-full max-w-4xl mx-auto flex flex-col items-center"
      >
        <h1
          class="text-6xl md:text-8xl font-bold mb-6 tracking-tight leading-tight text-center"
        >
          Think Fast. <br />
          Write Faster.
        </h1>
        <p
          class="text-xl md:text-2xl text-base-content/60 max-w-2xl mx-auto mb-10 leading-relaxed text-center"
        >
          The 2MB note-taking powerhouse. Native performance on every platform.
          Just you and your thoughts.
        </p>
        <div
          class="flex flex-col md:flex-row gap-4 justify-center items-center"
        >
          <a
            href="#download"
            class="btn btn-primary btn-lg rounded-full px-8 shadow-lg shadow-primary/20 hover:scale-105 transition-transform"
          >
            <iconify-icon icon="tabler:download"></iconify-icon>
            Download Free
          </a>
          <a
            href="https://github.com"
            target="_blank"
            class="btn btn-outline btn-lg rounded-full px-8 hover:bg-white/10"
          >
            <iconify-icon icon="tabler:brand-github"></iconify-icon>
            Source Code
          </a>
        </div>

        <div
          class="mt-16 flex justify-center gap-8 opacity-50 grayscale hover:grayscale-0 transition-all duration-500"
        >
          <iconify-icon icon="tabler:brand-windows" width="32"></iconify-icon>
          <iconify-icon icon="tabler:brand-apple" width="32"></iconify-icon>
          <iconify-icon icon="tabler:brand-android" width="32"></iconify-icon>
          <iconify-icon icon="tabler:brand-linux" width="32"></iconify-icon>
        </div>
      </div>
    </div>

    <div class="blob w-96 h-96 top-1/4 left-1/4 opacity-20"></div>
  </section>

  <!-- Screen 2: The Weight Problem (Comparison) -->
  <section id="speed" class="section-container bg-base-100 pb-40">
    <div class="container mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Size Matters</h2>
        <p class="text-xl text-base-content/60">
          Stop downloading entire web browsers just to write a grocery list.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center animate-on-scroll"
      >
        <!-- Standard App -->
        <div class="card bg-base-200/20 p-8 border border-white/5">
          <h3
            class="text-2xl font-bold mb-4 flex items-center gap-2 opacity-50"
          >
            <iconify-icon icon="tabler:turtle" class="text-error"
            ></iconify-icon>
            Standard "Modern" App
          </h3>
          <div
            class="w-full bg-base-300/30 rounded-full h-12 mb-2 relative overflow-hidden"
          >
            <div
              class="bg-error/30 h-full flex items-center justify-end px-4 text-error font-bold w-[95%]"
            >
              250 MB
            </div>
          </div>
          <p class="text-sm text-base-content/30 font-mono">
            Electron Backend + Chrome Runtime + Node Modules
          </p>
        </div>

        <!-- Cherit -->
        <div
          class="card bg-base-200 border border-primary p-8 shadow-2xl shadow-primary/10 relative overflow-visible"
        >
          <div
            class="absolute -top-4 -right-4 badge badge-primary badge-lg rotate-12"
          >
            Winner
          </div>
          <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
            <iconify-icon icon="tabler:bolt" class="text-primary"
            ></iconify-icon>
            Cherit
          </h3>
          <div class="w-full bg-base-300 rounded-full h-12 mb-2 relative">
            <div
              class="bg-primary h-full flex items-center justify-center text-primary-content font-bold w-[4%] min-w-[3rem] shadow-[0_0_20px_rgba(var(--p),0.5)]"
            >
              4 MB
            </div>
          </div>
          <p class="text-sm text-base-content/40 font-mono">
            Rust Core + Native UI WebView
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 3: Bento Grid Features -->
  <section id="features" class="section-container">
    <div class="container mx-auto">
      <div class="mb-12 animate-on-scroll text-center md:text-left">
        <h2 class="text-4xl font-bold mb-2">Everything you need.</h2>
        <p class="text-base-content/60">Nothing you don't.</p>
      </div>

      <!-- Changed grid to use flex on mobile and strict grid on lg to fix alignment -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Feature 1: Large (Markdown) -->
        <div class="lg:col-span-2 group animate-on-scroll">
          <div
            class="bento-card h-full flex flex-col relative overflow-hidden p-0 min-h-[320px]"
          >
            <div class="p-8 pb-0 z-10">
              <div
                class="i-tabler:markdown color-[var(--color-accent)] mb-4 text-accent size-8"
              >
              </div>
              <h3 class="text-3xl font-bold">Markdown Native</h3>
              <p class="text-base-content/60 mt-2 max-w-md">
                Write in standard Markdown. We render it beautifully in
