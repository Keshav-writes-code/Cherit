---
import BaseLayout from "@/layout/BaseLayout.astro";
import Navbar from "@/components/navbar.astro";
---

<BaseLayout
  theme="dark"
  class="font-sans isolate bg-black min-h-screen h-500 flex flex-col items-center"
>
  <div
    class="absolute inset-0 -z-10 h-full w-full items-center px-5 py-24 [background:radial-gradient(60%_200%_at_50%_0%,rgba(102,51,238,0.35)_0%,#000_100%)]"
  >
  </div>
  <div class="relative h-screen w-full bg-transparent overflow-hidden">
    <div
      class="absolute bottom-0 left-[-25%] right-[-25%] top-0 h-full w-[150%]
    bg-[linear-gradient(to_right,#4f4f4f47_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f47_1px,transparent_1px)]
      bg-[size:104px_70px]
[mask-image:radial-gradient(circle_farthest-corner_at_50%_50%,_rgba(0,_0,_0,_1)_0%,_rgba(0,_0,_0,_1)_25.5%,_rgba(255,_0,_0,_0)_47%)]
      transform-skew-y--20 translate-y--20"
    >
    </div>
  </div>
  <div class="w-full lg:fixed relative px-5 max-w-screen-xl">
    <Navbar />
  </div>
</BaseLayout>
