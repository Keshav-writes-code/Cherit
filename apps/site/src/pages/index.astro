              </p>
            </div>

            <!-- Code Editor Mockup - Positioned absolutely to stick to bottom-right -->
            <div
              class="absolute bottom-0 group-hover:z-20 right-0 w-3/4 translate-x-12 translate-y-6 group-hover:translate-y-2 group-hover:translate-x-8 transition-all duration-500 ease-out"
            >
              <div
                class="mockup-window h-50 w-full border border-base-300 bg-base-200"
              >
                <div
                  class="px-4 pt-4 flex flex-col border-t border-base-300 h-80 prose prose-sm prose-invert"
                >
                  <h1 class="mb-0"># Its all</h1>
                  <ul>
                    <li>Markdown</li>
                    <li>Latex</li>
                    <li>Tables</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column Stack -->
        <div class="flex flex-col gap-6 lg:col-span-1">
          <!-- Feature 2: Offline -->
          <div
