            </p>
          </div>
          <div
            class="flex-1 w-full h-40 md:h-full bg-base-300 rounded-xl overflow-hidden relative opacity-50"
          >
            <!-- Pseudo canvas UI -->
            <div
              class="absolute top-4 left-4 w-12 h-12 border-2 border-primary rounded-lg"
            >
            </div>
            <div
