  <!-- Screen 8: Testimonials -->
  <!-- Screen 9: Pricing (Modified - Free) -->
  <section class="section-container py-24">
    <div class="container mx-auto max-w-xl text-center animate-on-scroll">
      <h2 class="text-4xl font-bold mb-4">Pricing? What Pricing?</h2>
