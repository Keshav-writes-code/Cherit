---
import SiteLayout from "@/layout/SiteLayout.astro";
import Section1 from "@/components/home_page/section1/index.astro";
import Section2 from "@/components/home_page/section2/index.astro";
import type { PageMetadata } from "@/types";

let metadata: PageMetadata = {
  title: "Home",
  description:
    "Cherit is the 2MB note-taking powerhouse. Native performance on every platform. Markdown native, offline-first, and completely private. Just you and your thoughts.",
  open_graph: {
    title: "Cherit - Think Fast. Write Faster.",
    description:
      "Stop downloading entire web browsers just to write a grocery list. Cherit is a lightweight, local-first markdown editor.",
  },
  twitter: {
    title: "Cherit - The Lightweight Note-Taking App",
    description:
      "Native performance, 2MB size, Markdown support. Available on all platforms.",
  },
};
---

<SiteLayout page_metadata={metadata} class="grid place-items-center">
  <div class="-z-10 isolate w-full">
    <div
      class="absolute inset-0 h-full items-center px-5 py-24 [background:radial-gradient(60%_140%_at_50%_0%,rgba(102,51,238,0.35)_0%,#000_100%)]"
    >
    </div>
    <div class="absolute inset-0 z-1 bg-transparent overflow-hidden">
      <div
        class="absolute bottom-0 left-[-25%] right-[-25%] top-0 h-full w-[150%]
    bg-[linear-gradient(to_right,#4f4f4f47_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f47_1px,transparent_1px)]
      bg-[size:104px_70px]
[mask-image:radial-gradient(circle_farthest-corner_at_50%_50%,_rgba(0,_0,_0,_1)_0%,_rgba(0,_0,_0,_1)_25.5%,_rgba(255,_0,_0,_0)_47%)]
      transform-skew-y--20 translate-y--20"
      >
      </div>
    </div>
  </div>
  <Section1 class="mt-40" />
  <Section2 class="mt-20" />
</SiteLayout>
