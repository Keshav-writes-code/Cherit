{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cherit",
  "version": "0.0.1",
  "identifier": "io.github.keshav-writes-code.cherit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev --host",
    "beforeBuildCommand": "bun run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "cherit",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/org.your.id.metainfo.xml": "../distribute/linux/flatpak/metainfo.xml"
        }
      }
    }
  }
}
